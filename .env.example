# ============================================================
# Digital Shop Manager — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- MongoDB ----
# For transactions, MongoDB MUST be running as a replica set.
# Local replica set example: mongodb://127.0.0.1:27017/digital-shop?replicaSet=rs0
# Atlas example: mongodb+srv://<user>:<password>@cluster.mongodb.net/digital-shop
MONGO_URI=mongodb://127.0.0.1:27017/digital-shop?replicaSet=rs0

# ---- JWT ----
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# ---- Default Admin (used by seed script) ----
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@digitalshop.com
ADMIN_PASSWORD=Admin@1234!

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---- CORS ----
CLIENT_URL=http://localhost:5173

# ---- Logging ----
LOG_LEVEL=debug
