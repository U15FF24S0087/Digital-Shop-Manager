# Copy this file to server/.env (or set vars at the project root)
# This file mirrors the root .env.example — keep them in sync.

NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/digital-shop?replicaSet=rs0

JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@digitalshop.com
ADMIN_PASSWORD=Admin@1234!

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

CLIENT_URL=http://localhost:5173

LOG_LEVEL=debug
